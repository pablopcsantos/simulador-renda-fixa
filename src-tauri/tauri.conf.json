{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simulador de Renda Fixa",
  "version": "1.0.0",
  "identifier": "br.com.pablopcsantos.simuladorrendafixa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simulador de Renda Fixa",
        "width": 1280,
        "height": 850,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' https://api.bcb.gov.br; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
